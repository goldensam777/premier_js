{
  "name": "premier-js",
  "version": "0.1.0",
  "private": true,
  "description": "Un framework js pour générer toutes sortes de sites web.",
  "author": "Samuel YEVI",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint ."
},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goldensam777/premier_js.git"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "next": "^16.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.62.1"
  }
}
